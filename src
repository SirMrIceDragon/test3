  }
  
  return (
    <div className="px-4 py-4 space-y-4">
      {/* فاز فعلی */}
      {currentPhase ? (
        <Card 
          className="p-5 border-2"
          style={{ borderColor: currentPhase.color + '40', backgroundColor: currentPhase.color + '08' }}
        >
          <div className="flex items-center gap-3 mb-3">
