              <Badge variant="outline" className="text-xs h-5 gap-1">
                <AlarmClockOff className="h-3 w-3" />
                {toPersianDigits(alarm.snoozeMinutes)} دقیقه
              </Badge>
            )}
            {alarm.soundType === 'custom' && (
              <Badge variant="outline" className="text-xs h-5 gap-1">
