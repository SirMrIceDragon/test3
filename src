          <DialogDescription className="text-right">
            چرخه کار و استراحت بی‌نهایت تا وقتی خودت متوقف کنی
          </DialogDescription>
        </DialogHeader>
        
        <div className="space-y-4 pt-2">
          {/* presets */}
          <div className="space-y-2">
            <Label>پیش‌تنظیم‌ها</Label>
            <div className="grid grid-cols-2 gap-2">
