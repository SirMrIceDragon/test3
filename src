      )}
      
      {/* دکمه افزودن */}
      <Button onClick={() => setShowAddDialog(true)} className="w-full h-12">
        <Plus className="h-5 w-5 ml-2" />
        ثبت چرخه جدید
      </Button>
      
      {/* راهنمای فازها */}
      <Card className="p-4">
