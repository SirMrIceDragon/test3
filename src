          <div className="flex gap-2 pt-2">
            <Button variant="outline" className="flex-1" onClick={() => onOpenChange(false)}>انصراف</Button>
            <Button className="flex-1" onClick={() => onAdd({
              startDate,
              cycleLength,
              periodLength,
              symptoms: selectedSymptoms,
              notes: notes.trim(),
            })}>
              ذخیره
            </Button>
          </div>
        </div>
      </DialogContent>
    </Dialog>
  )
}

